    <PackageReference Include="OllamaSharp" Version="5.5.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FinDoc.Api\FinDoc.Api.csproj" />
    <ProjectReference Include="..\..\src\FinDoc.Core\FinDoc.Core.csproj" />
  </ItemGroup>

</Project>
